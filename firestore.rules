rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Global Safety Net
    // ---------------------------------------------------------
    match /{document=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------
    // Global Helpers
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    
    // Hardened isAdmin check
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) || 
        (request.auth.token.email == 'ali.islam.officials@gmail.com' && request.auth.token.email_verified == true)
      ); 
    }
    
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------------------------------------------------------
    // Products Collection
    // ---------------------------------------------------------
    match /products/{productId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidProduct(incoming());
      allow delete: if isAdmin();
      
      function isValidProduct(data) {
        // Matched exactly with firebase-blueprint.json
        let required = ['name', 'price', 'images', 'categoryId'];
        return data.keys().hasAll(required)
          && data.name is string && data.name.size() <= 200
          && data.price is number && data.price >= 0
          && data.categoryId is string
          && data.images is list;
      }
    }

    // ---------------------------------------------------------
    // Orders Collection
    // ---------------------------------------------------------
    match /orders/{orderId} {
      allow create: if isValidOrder(incoming());
      allow read, update, delete: if isAdmin();

      function isValidOrder(data) {
        // Matched exactly with firebase-blueprint.json
        let required = ['customerName', 'customerPhone', 'customerAddress', 'items', 'total'];
        return data.keys().hasAll(required)
          && data.customerName is string && data.customerName.size() > 0
          && data.customerPhone is string && data.customerPhone.size() >= 8
          && data.customerAddress is string && data.customerAddress.size() > 0
          && data.total is number && data.total >= 0
          && data.items is list && data.items.size() > 0;
      }
    }

    // ---------------------------------------------------------
    // Banners Collection (Added for Homepage)
    // ---------------------------------------------------------
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Settings Collection
    // ---------------------------------------------------------
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Categories & Admins
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
